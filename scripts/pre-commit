#!/usr/bin/env bash
# Block dataset bytes from ever entering this public repository.
#
# WHY THIS EXISTS AS A HOOK AND NOT A HABIT
#
# R17 (datasets committed to the public repo) has nearly fired TWICE, both times
# from a path nobody predicted:
#
#   1. anomalib downloads to ./datasets/, not the ./data/ the PRD specified.
#   2. anomalib's test() writes DERIVED MVTec images under artifacts/, and a
#      routine `git add -A` staged 115 of them.
#
# Both were caught only by a manual audit run before committing. That is a habit,
# and habits degrade under deadline pressure -- exactly when November arrives and
# everyone is tired. MVTec AD is CC BY-NC-SA and this repository is public, so the
# failure is a licence violation, not an inconvenience.
#
# Install:
#     git config core.hooksPath scripts
#
# Bypass (only with a reason you can defend):
#     git commit --no-verify

set -euo pipefail

# Binary media plus model weights. Kept deliberately broad: the two near-misses
# were both file types we had not thought to list.
BLOCKED_PATTERN='\.(png|jpg|jpeg|bmp|tiff?|gif|webp|wav|flac|mp3|ogg|npy|npz|ckpt|pt|pth|safetensors|tar|tar\.xz|tar\.gz|zip|7z)$'

# Narrow allowlist. A test fixture must be small and deliberate; anything else
# belongs outside the repo.
ALLOWED_PATTERN='^(tests/fixtures/|docs/img/)'

staged=$(git diff --cached --name-only --diff-filter=ACMR || true)
[ -z "$staged" ] && exit 0

offenders=$(echo "$staged" | grep -iE "$BLOCKED_PATTERN" | grep -vE "$ALLOWED_PATTERN" || true)

if [ -n "$offenders" ]; then
  echo "BLOCKED: staged files look like dataset or model bytes." >&2
  echo >&2
  echo "$offenders" | sed 's/^/  /' >&2
  echo >&2
  echo "This repository is public and MVTec AD is CC BY-NC-SA (see DATA.md)." >&2
  echo "Datasets, derived images, and model weights must never be committed." >&2
  echo >&2
  echo "Fix:  git reset HEAD -- <path>    and add the path to .gitignore" >&2
  echo "Small, deliberate test fixtures belong in tests/fixtures/." >&2
  exit 1
fi

# Secrets. Cheap to check, unrecoverable if missed: a pushed key is a leaked key
# even after the commit is reverted.
secrets=$(echo "$staged" | grep -E '(^|/)\.env$|\.env\.(local|production)$|\.pem$|\.key$|_rsa$' || true)
if [ -n "$secrets" ]; then
  echo "BLOCKED: staged file looks like a secret." >&2
  echo "$secrets" | sed 's/^/  /' >&2
  echo >&2
  echo "config/default.env is the committed template; .env holds real values" >&2
  echo "and is gitignored. Never commit an API key -- rotate it if you have." >&2
  exit 1
fi

# Oversized text (a fixture that grew, a log that escaped). 1 MB is generous for
# anything legitimately in this tree.
while IFS= read -r file; do
  [ -f "$file" ] || continue
  size=$(wc -c < "$file" | tr -d ' ')
  if [ "$size" -gt 1048576 ]; then
    echo "BLOCKED: $file is $((size / 1024)) KB (limit 1024 KB)." >&2
    echo "Large generated output belongs outside the repo. Override with" >&2
    echo "--no-verify only if you are certain this file must be versioned." >&2
    exit 1
  fi
done <<< "$staged"

exit 0
