# The one file that selects every implementation behind every seam.
#
# Copy to .env at the repo root and edit, or export these directly.
# .env is gitignored; this template is committed.
#
# Usage:
#   cp config/default.env .env
# Then change ONE line below to swap an entire subsystem.

# ---------------------------------------------------------------------------
# LLM provider -- THE local-to-API switch.
#   ollama  local qwen3:4b, privacy-preserving, slow on CPU (PRD R22)
#   gemini  hosted Flash, fast, quota-constrained (PRD R2/R21)
#   stub    deterministic, no network, for tests
# ---------------------------------------------------------------------------
IRA_LLM__PROVIDER=ollama
IRA_LLM__CACHED=true
IRA_LLM__OLLAMA_MODEL=qwen3:4b
IRA_LLM__OLLAMA_NO_THINK=true
IRA_LLM__GEMINI_MODEL=gemini-2.5-flash
IRA_LLM__SEED=0
IRA_LLM__TEMPERATURE=0.0
IRA_LLM__MAX_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Detectors. 'mock' until trained weights exist.
# ---------------------------------------------------------------------------
IRA_DETECTOR__IMPL=mock

# ---------------------------------------------------------------------------
# Event source.
#   synthetic  generate incidents (real labelling + oracle, mock payload bytes)
#   replay     read a frozen JSONL fixture -- use this for reproducible eval
# ---------------------------------------------------------------------------
IRA_HARNESS__IMPL=synthetic
IRA_HARNESS__N_MACHINES=3
IRA_HARNESS__SEED=0

# ---------------------------------------------------------------------------
# Memory. enabled=false is ablation A3.
# ---------------------------------------------------------------------------
IRA_MEMORY__IMPL=sqlite
IRA_MEMORY__ENABLED=true

# ---------------------------------------------------------------------------
# Dispatch sink. 'local_stub' lets the workflow run with no A2A process up.
# NOTE: the A2A agent card's origin is enforced -- localhost != 127.0.0.1.
# ---------------------------------------------------------------------------
IRA_DISPATCH__IMPL=local_stub
IRA_DISPATCH__A2A_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# Tracing. 'noop' for tests and machines without Phoenix running.
# ---------------------------------------------------------------------------
IRA_TRACING__IMPL=noop

# ---------------------------------------------------------------------------
# Stamped into every results table and decisions.jsonl (PRD R23).
# Change this when running on Colab: dev is local CPU, eval is Colab GPU, and
# different quantisations give different outputs.
# ---------------------------------------------------------------------------
IRA_RUN_ENVIRONMENT=local-cpu

# ---------------------------------------------------------------------------
# Secret. Put the real value in .env only. NEVER commit it.
# Get one at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# IRA_GOOGLE_API_KEY=
