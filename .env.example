# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# Gemini via AI Studio (free tier, NO billing account). ADK reads GOOGLE_API_KEY.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
REVAMP_GEMINI_MODEL=gemini-2.5-flash

# ---- Local models through Ollama (default mode) --------------------------------------
# Where Ollama runs. Same machine: http://localhost:11434. Another machine on the LAN
# (e.g. a friend's GPU laptop running `OLLAMA_HOST=0.0.0.0 ollama serve`): http://<its-ip>:11434
OLLAMA_API_BASE=http://localhost:11434

# Three tiers (see revamp/llm/registry.py LOCAL_TIER for which agent uses which).
# Use these EXACT tags: plain "qwen3:4b" and "qwen3-vl:4b" are THINKING variants.
REVAMP_OLLAMA_INSTRUCT=qwen3:4b-instruct-2507-q4_K_M
REVAMP_OLLAMA_THINKING=qwen3:4b-thinking-2507-q4_K_M
REVAMP_OLLAMA_VISION=qwen3-vl:4b-instruct
# Bigger GPU (>= 12 GB VRAM)? Try qwen3:8b-style upgrades per tier here.

# GPU: layers offloaded to the GPU. 999 = all (force GPU). -1 = let Ollama decide. 0 = CPU.
REVAMP_OLLAMA_NUM_GPU=999
# Keep models in memory between calls, so each agent call does not reload the model.
REVAMP_OLLAMA_KEEP_ALIVE=30m
# Context windows per tier. Lower them if `revamp doctor --gpu` says "partly on CPU".
REVAMP_NUM_CTX=8192
REVAMP_NUM_CTX_THINKING=16384
REVAMP_NUM_CTX_VISION=16384
# Seconds per model call.
REVAMP_LLM_TIMEOUT=900
# Optional: move agents between tiers, e.g. REVAMP_LOCAL_TIERS=red_team=instruct,design=thinking
REVAMP_LOCAL_TIERS=

# GitHub personal access token (public_repo read scope is enough).
GITHUB_TOKEN=

# PageSpeed Insights key from a Cloud project WITHOUT billing. Optional but recommended.
PSI_API_KEY=

# Route every agent to one model family: "local" (default), "hybrid", or "gemini".
REVAMP_MODEL_MODE=local

# Where the LLM cache lives, and whether a cache miss is allowed to call a model.
REVAMP_CACHE_DIR=cache/llm
REVAMP_CACHE_READ_ONLY=0

# Phoenix collector. Leave empty to disable tracing.
PHOENIX_COLLECTOR_ENDPOINT=

# Langfuse: self-hosted (deploy/langfuse, keys in deploy/langfuse/.env) or Langfuse Cloud
# Hobby (free, no card: https://cloud.langfuse.com). Empty host = disabled.
LANGFUSE_SECRET_KEY="sk-lf-52d6be41-da18-4fb9-b2ad-da29438be91e"
LANGFUSE_PUBLIC_KEY="pk-lf-19e10bb5-b6cc-4e09-90f2-3ed9477ba086"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Client agent as a separate A2A process (python -m revamp.client_service). Empty = in-process.
# Use localhost, not 127.0.0.1: the agent card origin is enforced.
REVAMP_CLIENT_URL=
