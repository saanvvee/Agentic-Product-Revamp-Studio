# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# Gemini via AI Studio (free tier, NO billing account). ADK reads GOOGLE_API_KEY.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
REVAMP_GEMINI_MODEL=gemini-2.5-flash

# Local model through Ollama.
OLLAMA_API_BASE=http://localhost:11434
REVAMP_LOCAL_MODEL=ollama_chat/qwen3:4b

# GitHub personal access token (public_repo read scope is enough).
GITHUB_TOKEN=

# PageSpeed Insights key from a Cloud project WITHOUT billing. Optional but recommended.
PSI_API_KEY=

# Route every agent to one model family: "hybrid" (default), "local", or "gemini".
REVAMP_MODEL_MODE=hybrid

# Where the LLM cache lives, and whether a cache miss is allowed to call a model.
REVAMP_CACHE_DIR=cache/llm
REVAMP_CACHE_READ_ONLY=0

# Phoenix collector. Leave empty to disable tracing.
PHOENIX_COLLECTOR_ENDPOINT=

# Client agent as a separate A2A process (python -m revamp.client_service). Empty = in-process.
# Use localhost, not 127.0.0.1: the agent card origin is enforced.
REVAMP_CLIENT_URL=
